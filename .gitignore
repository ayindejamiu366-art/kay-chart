# Dependencies
node_modules/

# Build output
dist/

# Android build outputs (not source)
android/app/build/
android/app/*.apk
android/app/*.aab
android/*.iml
.android/

# Environment / secrets (never commit)
.env
.env.firebase
.env.local
*.env
serviceAccountKey.json

