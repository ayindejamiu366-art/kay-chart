server/nocturne.db
server/nocturne.db-shm
server/nocturne.db-wal

# Uploaded media (runtime-generated)
server/uploads/audio/*
server/uploads/covers/*
!server/uploads/audio/.gitkeep
!server/uploads/covers/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
