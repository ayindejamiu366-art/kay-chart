    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <path android:fillColor="#0A0A0F" android:pathData="M0,0h288v288H0z" />

    <!--
        Mark, scaled from the 512-unit source into the middle of the 288 canvas
        with room around it. Group order draws the K, then cuts the play counter.
