<!--
    Kay Chart launcher foreground.

    Adaptive icons are 108dp with only the centre 72dp guaranteed visible, so the
    mark is drawn inside that safe zone: the artwork spans roughly x=36..72,
    y=28..80 in this viewport, leaving room for the system to mask it into any
    launcher shape.

    The K is filled geometry rather than strokes because Android's vector format
    does not support gradient strokes the way SVG does. A single flat lime keeps
    it consistent with the SVG mark at icon sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:fillColor="#D6FF3D"
        android:pathData="M38,34 h7 a3,3 0 0 1 3,3 v34 a3,3 0 0 1 -3,3 h-7 a3,3 0 0 1 -3,-3 v-34 a3,3 0 0 1 3,-3 z" />

    <!-- Upper arm -->
    <path
        android:fillColor="#D6FF3D"
        android:pathData="M45,52 L48,56 L74,30 L71,26 Z" />

    <!-- Lower arm -->
    <path
        android:fillColor="#D6FF3D"
        android:pathData="M48,52 L45,56 L71,82 L74,78 Z" />

    <!--
        Play counter, cut in the launcher background colour so it reads as
        negative space inside the K.
    -->
    <path
        android:fillColor="#0A0A0F"
        android:pathData="M52,49 L64,56 L52,63 Z" />
</vector>