<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (src/debug overrides src/main).

  Lets the app talk to a Nocturne backend on the developer's machine over plain
  http, e.g. http://192.168.1.5:3001. Cleartext cannot be scoped to a CIDR range
  in Android's model — <domain> entries match by hostname — so debug builds allow
  it generally. Release builds are unaffected: they use the main configuration,
  which permits https only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
