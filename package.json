{
  "name": "KayChart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,vite --prefix-colors blue,green \"node server/index.cjs\" \"vite\"",
    "dev:server": "node server/index.cjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.cjs",
    "start:prod": "vite build && node server/index.cjs",
    "android": "npx cap open android",
    "cap:sync": "npx cap sync android",
    "cap:build": "vite build && npx cap sync android",
    "cap:run": "npx cap run android",
    "lan-address": "node scripts/lan-address.cjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "esbuild": "^0.24.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.39",
    "prettier": "^3.9.7",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
