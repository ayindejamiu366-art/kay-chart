# Nocturne environment variables — template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Generate a strong JWT secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# === Authentication (REQUIRED) ===
# WARNING: Server will refuse to start without this. Generate a strong random string (48+ chars).
JWT_SECRET=CHANGE_ME_to_a_long_random_string

# Supabase (https://app.supabase.com) — optional, for Google/Supabase auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === API Configuration ===
# Leave empty for local dev/production (relative /api is used automatically).
# Set to absolute URL for Capacitor/native builds where frontend != backend origin.
#
# Android / iOS: the app is served from its own origin (https://localhost) and
# has no backend there, so a relative "/api" can never work on a device — the
# app opens and every request fails. Either:
#   1. Leave this empty and enter your computer's address in the app's
#      "Connect to your server" screen (the app stores it, so one build works
#      against any server). Run `npm run lan-address` to print the address.
#   2. Or set it here and rebuild, e.g. for a deployed API:
#      VITE_API_BASE_URL=https://api.yourdomain.com/api
#      VITE_API_BASE_URL=http://192.168.1.5:3001/api   (same Wi-Fi, debug build)
# Debug builds permit plain http for LAN development; release builds require https.
VITE_API_BASE_URL=

# === Music Providers ===
# Deezer (free, no API key required) — provides 30-second previews
MUSIC_PROVIDER_1=deezer
MUSIC_PROVIDER_1_BASE_URL=https://api.deezer.com

# Audius (free, no API key required) — provides FULL-LENGTH streaming
MUSIC_PROVIDER_2=audius
MUSIC_PROVIDER_2_BASE_URL=https://api.audius.co

# Spotify (metadata + 30s previews only, client credentials required)
MUSIC_PROVIDER_3=spotify
MUSIC_PROVIDER_3_API_KEY=
MUSIC_PROVIDER_3_BASE_URL=https://api.spotify.com/v1
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local uploaded music
MUSIC_PROVIDER_4=local

# Jamendo (independent/open catalog)
MUSIC_PROVIDER_5=jamendo
MUSIC_PROVIDER_5_API_KEY=

# Jamendo (independent/open catalog, requires API key from https://developer.jamendo.com)
# Get your client ID from: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Trending sync interval in minutes (default 30)
TRENDING_SYNC_INTERVAL=30

# === Email / Gmail SMTP (for OTP verification) ===
# Gmail account for sending OTP emails via SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Web3Forms key for transactional email (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=

# Google Sign-In web client ID (public, optional)
VITE_GOOGLE_CLIENT_ID=

# === Admin Bootstrap ===
ADMIN_EMAIL=admin@nocturne.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# === Security ===
# Set to 1 ONLY for local development. Server warns if enabled in production.
ALLOW_OTP_DEV_CODE=0

# === Firebase (separate file) ===
# Firebase configuration is stored in .env.firebase (not committed).
# See .env.firebase.example for required variables.
